{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "veyra-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development"
  },
  // R2 Bucket Binding (uncomment when R2 is enabled)
  // "r2_buckets": [
  //   {
  //     "binding": "R2_BUCKET",
  //     "bucket_name": "veyra-media",
  //     "preview_bucket_name": "veyra-media-preview"
  //   }
  // ],
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "routes": [
        {
          "pattern": "api-staging.veyra.app/*",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      },
      "routes": [
        {
          "pattern": "api.veyra.app/*",
          "custom_domain": true
        }
      ]
    }
  }
}
