{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "veyra-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "FIREBASE_PROJECT_ID": "omix-systems-cd1af",
    "ADMIN_EMAILS": "",
    // Veyra is accountless: guests are identified by an anonymous device id.
    // Set to "false" to require a Firebase token again.
    "GUEST_MODE": "true"
    // Secrets (never put these in "vars"):
    //   wrangler secret put DATABASE_URL
    //   wrangler secret put TMDB_API_READ_ACCESS_TOKEN
    //   wrangler secret put ADMIN_ACCESS_KEY      # unlocks /api/admin/*
    //   wrangler secret put YOUTUBE_API_KEY       # optional, server-side only
    //   wrangler secret put CORS_ORIGIN
  },
  // R2 Bucket Binding
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "veyra-media",
      "preview_bucket_name": "veyra-media-preview"
    }
  ],
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "veyra-media-staging",
          "preview_bucket_name": "veyra-media-staging-preview"
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      },
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "veyra-media"
        }
      ]
    }
  }
}
